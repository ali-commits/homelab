ignore/

# Ignore Visual Studio Code files
.vscode/
*.code-workspace
.env
# Backups and variants of .env hold the same secrets as .env itself; the bare
# `.env` rule does not match .env.bak / .env.local / .env.save and they would
# otherwise be committed to a public repository.
.env.*
!.env.example
!.env.template
.pnpm

# Ignore sensitive configuration files
configs/defaults/*

calligraphy-compare*
.github

# graphify knowledge-graph output (regenerate with: graphify extract .)
graphify-out/

