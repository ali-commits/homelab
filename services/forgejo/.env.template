# Forgejo - RedRipper Forge
# Copy to .env and fill in. The real .env is gitignored; never commit secrets.
#
# Generate the secret values with:
#   docker run --rm --entrypoint forgejo codeberg.org/forgejo/forgejo:16 generate secret SECRET_KEY
#   docker run --rm --entrypoint forgejo codeberg.org/forgejo/forgejo:16 generate secret INTERNAL_TOKEN
#   docker run --rm --entrypoint forgejo codeberg.org/forgejo/forgejo:16 generate secret JWT_SECRET
#   docker run --rm --entrypoint forgejo codeberg.org/forgejo/forgejo:16 generate secret LFS_JWT_SECRET
#   openssl rand -hex 24   # for DB_PASSWORD

# --- Instance secrets (required) ---
SECRET_KEY=
INTERNAL_TOKEN=
JWT_SECRET=
LFS_JWT_SECRET=

# --- Database (required) ---
DB_PASSWORD=

# --- Zitadel OIDC (required for SSO) ---
# Create the application in the Zitadel console:
#   Projects -> Homelab -> New Application
#   Name: Forgejo | Type: Web | Auth method: Basic
#   Redirect URI: https://git.alimunee.com/user/oauth2/zitadel/callback
# Then register the source once with:
#   docker exec -u git forgejo forgejo admin auth add-oauth \
#     --name zitadel --provider openidConnect \
#     --key "$ZITADEL_CLIENT_ID" --secret "$ZITADEL_CLIENT_SECRET" \
#     --auto-discover-url https://zitadel.alimunee.com/.well-known/openid-configuration \
#     --scopes openid --scopes email --scopes profile
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# --- Actions runner (required for CI) ---
# Obtain after first boot:  docker exec -u git forgejo forgejo actions generate-runner-token
RUNNER_REGISTRATION_TOKEN=
